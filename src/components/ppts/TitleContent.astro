---
interface Props {
  slide: {
    title?: string;
    content: string;
    background?: string;
    backgroundColor?: string;
    backgroundImage?: string;
    transition?: string;
    [key: string]: any;
  };
  config?: Record<string, any>;
  index?: number;
}

const { slide = {} } = Astro.props;
const {
  title = '',
  content = '',
  background,
  backgroundColor,
  backgroundImage,
  transition,
} = slide;
---

<section
  data-background-color={backgroundColor || background}
  data-background-image={backgroundImage}
  data-transition={transition}
  class="slide-cover"
>
  {title && <h1>{title}</h1>}
  {content && <p>{content}</p>}
</section>

<style>
</style>
